<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find DM25PD04_EG_URDF_tianji_20260807)/urdf/DM25PD04_EG_URDF_tianji_20260807.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find DM25PD04_EG_URDF_tianji_20260807)/urdf.rviz" />
</launch>